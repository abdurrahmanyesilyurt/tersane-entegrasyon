<Project>
  <!-- Every dependency is MIT, Apache-2.0 or BSD licensed. -->
  <PropertyGroup>
    <!-- Lets the pins below override vulnerable transitive versions (NuGet audit fails the build on them). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Security pins">
    <!-- Microsoft.Data.SqlClient 6.1.7 pulls Pkcs 9.0.11 (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Label="Data">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Label="Hosting / HTTP">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OData" Version="9.5.0" />
  </ItemGroup>
  <ItemGroup Label="RPA">
    <PackageVersion Include="Microsoft.Playwright" Version="1.65.0" />
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!-- xunit.v3 4.x only ships for Microsoft.Testing.Platform v2; 3.x keeps the standard VSTest `dotnet test`. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.17.0" />
  </ItemGroup>
</Project>
