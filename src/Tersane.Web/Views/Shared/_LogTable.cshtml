@model List<IntegrationLog>
<div class="table-wrap">
    <table class="table-x">
        <thead><tr><th>Zaman</th><th>Yön</th><th>İşlem</th><th>Seviye</th><th class="num">HTTP</th><th class="num">ms</th><th class="num">Deneme</th><th>Mesaj</th><th></th></tr></thead>
        <tbody>
        @foreach (var l in Model)
        {
            <tr class="@(l.Level == "Error" ? "row-err" : "")">
                <td class="mono">@Ui.Local(l.OccurredAt, "dd.MM HH:mm:ss")</td>
                <td>@Ui.Direction(l.Direction)</td>
                <td class="mono">@l.Operation</td>
                <td>@Html.Pill(Ui.LogLevel(l.Level))</td>
                <td class="num">@(l.HttpStatus?.ToString() ?? "")</td>
                <td class="num">@(l.DurationMs?.ToString() ?? "")</td>
                <td class="num">@(l.Attempt?.ToString() ?? "")</td>
                <td class="small">@l.Message</td>
                <td>@if (l.RequestBody is not null || l.ResponseBody is not null) { <button type="button" class="btn btn-sm btn-link js-log-detail" data-id="@l.Id">detay</button> }</td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="9" class="empty">Log kaydı yok.</td></tr>
        }
        </tbody>
    </table>
</div>

@* One modal per page; filled by site.js from /entegrasyon/log/{id}. *@
<div class="modal fade" id="log-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Log detayı</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button></div>
            <div class="modal-body">
                <p class="mono small" id="log-url"></p>
                <h6>İstek</h6><pre class="payload" id="log-request"></pre>
                <h6>Yanıt</h6><pre class="payload" id="log-response"></pre>
            </div>
        </div>
    </div>
</div>
