<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Short-lived database calls in tests; passing TestContext.Current.CancellationToken everywhere adds noise. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.MsSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tersane.Data\Tersane.Data.csproj" />
    <ProjectReference Include="..\..\src\Tersane.ErpMock\Tersane.ErpMock.csproj" />
    <ProjectReference Include="..\..\src\Tersane.Worker\Tersane.Worker.csproj" />
    <ProjectReference Include="..\..\src\Tersane.Web\Tersane.Web.csproj" />
    <ProjectReference Include="..\..\src\Tersane.EskiAmbar\Tersane.EskiAmbar.csproj" />
    <ProjectReference Include="..\..\src\Tersane.Rpa\Tersane.Rpa.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
